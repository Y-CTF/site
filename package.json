{
    "name": "yctf.ch",
    "version": "1.0.0",
    "description": "Source of the yctf.ch website.",
    "license": "MIT",
    "scripts": {
        "dev": "baudelaire serve --open",
        "build": "baudelaire build",
        "css:build": "pnpm tailwindcss -i ./styles/main.css -o ./assets/css/main.css -m",
        "css:dev": "pnpm tailwindcss -i ./styles/main.css -o ./assets/css/main.css --watch -m"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.0.9",
        "@tailwindcss/typography": "^0.5.16",
        "tailwindcss": "^4.0.9"
    },
    "packageManager": "pnpm@10.13.1"
}
